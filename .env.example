# KriptoYoi — Environment Variables Template
# Salin file ini menjadi .env lalu isi nilainya

# -----------------------------------------------------------------------
# Tokocrypto API Key (opsional — dibutuhkan untuk endpoint private)
# Dapatkan di: https://www.tokocrypto.com/account/api
# -----------------------------------------------------------------------
apikey_tokocrypto=

# -----------------------------------------------------------------------
# Discord Webhook Notifier
# Cara setup (gratis, tanpa bot account):
#   1. Buka Discord server kamu
#   2. Edit Channel → Integrations → Webhooks → New Webhook
#   3. Klik "Copy Webhook URL"
#   4. Tempel di bawah
# -----------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
